# Copy to .env and fill in. Never commit the real .env.

# --- Required to actually create Devin sessions ---
DEVIN_API_BASE=https://api.devin.ai
DEVIN_API_TOKEN=your-devin-api-token

# --- Optional ---
PORT=3000
# Set DRY_RUN=1 to parse + build the prompt without calling the Devin API.
DRY_RUN=0
# Post each incident to Slack via an Incoming Webhook (leave blank to disable),
# so the Dynatrace -> Devin flow is visible in Slack as well as in Devin.
SLACK_WEBHOOK_URL=

# Repo context injected into the Devin prompt.
TARGET_REPO_URL=https://github.com/bishwap/fineract
TARGET_REPO_REF=demo/java11-baseline
FAILING_ENDPOINT=POST /fineract-provider/api/v1/fixeddepositaccounts (Fixed Deposit create: submitFDApplication)

# --- Optional: Dynatrace watcher (scripts/watch-dynatrace.js) ---
# Grail tenants expose no classic problem-notification webhook and gate Workflow
# JavaScript behind a per-user in-UI permission, so the watcher reads Dynatrace's
# own detection data via DQL and triggers the relay when the failure spike appears.
DT_ENVIRONMENT=https://xxxxxxxx.apps.dynatrace.com
DT_DQL_TOKEN=your-dynatrace-platform-token-with-storage-read-scope
RELAY_URL=http://localhost:3000
FAIL_ENDPOINT=submitApplication
FAIL_THRESHOLD=5
WINDOW_MINUTES=10
POLL_SECONDS=20
