# Copy to .env.deploy and fill in. NEVER commit the filled-in file.

# Public hostname for the banking console (a DNS A record must point at the VM).
# Leave blank to serve over plain http on the VM's IP address.
DOMAIN=demo.example.com

# --- Devin (so the console can open remediation sessions) ---
DEVIN_API_BASE=https://api.devin.ai
DEVIN_API_TOKEN=

# --- Dynatrace (so the console can raise the Problem card) ---
DT_ENVIRONMENT=https://xxxxx.apps.dynatrace.com
DT_DQL_TOKEN=
DT_ENTITY=SERVICE-XXXXXXXXXXXXXXXX
FAIL_ENDPOINT=submitApplication

# --- Demo tuning ---
REPO_URL=https://github.com/bishwap/fineract
BANK_NAME=Meridian Bank
FIRE_COUNT=1
FD_CLIENT_ID=226
FD_PRODUCT_ID=223
DRY_RUN=0
